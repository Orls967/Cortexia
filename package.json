{
  "name": "cortexia",
  "private": true,
  "version": "1.0.0",
  "description": "CORTEXIA — Comprehensive Neuroscience & Computational Brain Systems Platform",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "npm run data && vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests scripts",
    "build": "npm run data && npm run typecheck && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test": "npm run data && vitest run",
    "test:watch": "vitest",
    "bench": "node scripts/run-benchmarks.mjs",
    "e2e": "playwright test",
    "e2e:live": "playwright test --config playwright.live.config.ts",
    "audit:docs": "python3 tools/documentation-audit/run_audit.py"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
