{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortexia.science/schemas/molecular/molecular-entity.schema.json",
  "title": "MolecularEntity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "canonicalName",
    "molecularCategory",
    "primaryScale",
    "ionOrLigandSpecificity",
    "biophysicalMechanism",
    "educationalScopeNote",
    "references",
    "schemaVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MOL-[A-Z0-9-]+$"
    },
    "canonicalName": {
      "type": "string",
      "minLength": 2
    },
    "geneOrSubunitSymbols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "molecularCategory": {
      "type": "string",
      "enum": [
        "VOLTAGE_GATED_CHANNEL",
        "LIGAND_GATED_RECEPTOR",
        "METABOTROPIC_GPCR",
        "NEUROTRANSMITTER",
        "NEUROPEPTIDE",
        "TRANSPORTER_OR_PUMP",
        "VESICLE_TRAFFICKING_PROTEIN",
        "INTRACELLULAR_SIGNALING"
      ]
    },
    "primaryScale": {
      "type": "string",
      "enum": [
        "L1",
        "L2"
      ]
    },
    "ionOrLigandSpecificity": {
      "type": "string",
      "minLength": 2
    },
    "biophysicalMechanism": {
      "type": "string",
      "minLength": 40
    },
    "reversalPotentialMv": {
      "type": [
        "number",
        "null"
      ]
    },
    "educationalScopeNote": {
      "type": "string",
      "minLength": 20
    },
    "associatedModelIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^MODEL-[0-9]{3}$"
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^REF-[A-Z0-9-]+$"
      }
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    }
  }
}
