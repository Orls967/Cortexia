{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortexia.science/schemas/datasets/dataset.schema.json",
  "title": "DatasetCatalogEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "category",
    "sourceRepository",
    "provenanceType",
    "format",
    "license",
    "attributionText",
    "primaryScale",
    "units",
    "description",
    "references",
    "schemaVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DSET-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "category": {
      "type": "string",
      "enum": [
        "ANATOMICAL_ATLAS",
        "MICROSCOPIC_MORPHOLOGY",
        "ELECTROPHYSIOLOGY_TRACE",
        "FUNCTIONAL_AND_NETWORK"
      ]
    },
    "sourceRepository": {
      "type": "string",
      "enum": [
        "ALLEN_BRAIN_ATLAS",
        "NEUROMORPHO_ORG",
        "OPENNEURO",
        "EBRAINS",
        "DANDI_ARCHIVE",
        "MODELDB",
        "CORTEXIA_SYNTHETIC_BENCHMARK"
      ]
    },
    "provenanceType": {
      "type": "string",
      "enum": [
        "EMPIRICAL_CURATED_SUBSET",
        "SYNTHETIC_BENCHMARK"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "JSON_PARCELLATION",
        "SWC_ASCII",
        "BIDS_EEG_CSV",
        "NWB_EXTRACTED_JSON",
        "CONNECTOME_MATRIX_JSON"
      ]
    },
    "license": {
      "type": "string",
      "enum": [
        "CC0-1.0",
        "CC-BY-4.0",
        "ALLEN_NONCOMMERCIAL",
        "SYNTHETIC_INTERNAL"
      ]
    },
    "attributionText": {
      "type": "string",
      "minLength": 20
    },
    "primaryScale": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6",
        "L7",
        "L8",
        "L9"
      ]
    },
    "samplingRateHz": {
      "type": [
        "number",
        "null"
      ]
    },
    "channelCount": {
      "type": [
        "integer",
        "null"
      ]
    },
    "units": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 40
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^REF-[A-Z0-9-]+$"
      }
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    }
  }
}
