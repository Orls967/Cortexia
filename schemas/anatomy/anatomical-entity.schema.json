{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortexia.science/schemas/anatomy/anatomical-entity.schema.json",
  "title": "AnatomicalEntity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "canonicalName",
    "tnaLatinName",
    "aliases",
    "division",
    "parentId",
    "primaryScale",
    "atlasProvenance",
    "provenanceClass",
    "shortDefinition",
    "biologicalRole",
    "references",
    "schemaVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ANAT-[A-Z0-9-]+$"
    },
    "canonicalName": {
      "type": "string",
      "minLength": 2
    },
    "tnaLatinName": {
      "type": "string",
      "minLength": 2
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "division": {
      "type": "string",
      "enum": [
        "ROOT",
        "HEMISPHERES_COMMISSURES",
        "CEREBRAL_LOBES",
        "GYRI_AND_SULCI",
        "CEREBRAL_CORTEX",
        "BASAL_GANGLIA",
        "THALAMUS_HYPOTHALAMUS",
        "HIPPOCAMPAL_FORMATION",
        "AMYGDALA_LIMBIC",
        "CEREBELLUM",
        "BRAINSTEM",
        "VENTRICULAR_MENINGEAL",
        "SPINAL_CORD",
        "PERIPHERAL_NERVOUS_SYSTEM",
        "CRANIAL_NERVES",
        "WHITE_MATTER_TRACTS"
      ]
    },
    "parentId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ANAT-[A-Z0-9-]+$"
    },
    "primaryScale": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6",
        "L7",
        "L8",
        "L9"
      ]
    },
    "mniCentroidMm": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "atlasProvenance": {
      "type": "string",
      "minLength": 3
    },
    "provenanceClass": {
      "type": "string",
      "enum": [
        "ATLAS_SURFACE_DERIVED",
        "SCHEMATIC_ANATOMICAL",
        "CONCEPTUAL_DIAGRAM_3D"
      ]
    },
    "shortDefinition": {
      "type": "string",
      "minLength": 40
    },
    "biologicalRole": {
      "type": "string",
      "minLength": 40
    },
    "connectedStructureIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ANAT-[A-Z0-9-]+$"
      }
    },
    "associatedSystemIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SYS-[A-Z0-9-]+$"
      }
    },
    "associatedModelIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^MODEL-[0-9]{3}$"
      }
    },
    "assetId": {
      "type": "string",
      "pattern": "^ASSET-[A-Z0-9-]+$"
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^REF-[A-Z0-9-]+$"
      }
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    }
  }
}
