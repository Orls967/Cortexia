{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortexia.science/schemas/anatomy/functional-system.schema.json",
  "title": "FunctionalBrainSystem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "canonicalName",
    "primaryScale",
    "coreStructureIds",
    "circuitIds",
    "mechanismIds",
    "associatedModelIds",
    "systemSummary",
    "references",
    "schemaVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SYS-[A-Z0-9-]+$"
    },
    "canonicalName": {
      "type": "string",
      "minLength": 3
    },
    "primaryScale": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6",
        "L7",
        "L8",
        "L9"
      ]
    },
    "coreStructureIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ANAT-[A-Z0-9-]+$"
      }
    },
    "circuitIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^CIRC-[A-Z0-9-]+$"
      }
    },
    "mechanismIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^MECH-[A-Z0-9-]+$"
      }
    },
    "associatedModelIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^MODEL-[0-9]{3}$"
      }
    },
    "systemSummary": {
      "type": "string",
      "minLength": 30
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^REF-[A-Z0-9-]+$"
      }
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    }
  }
}
