{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortexia.science/schemas/experiments/simulation-output.schema.json",
  "title": "SimulationOutputPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "modelId",
    "sampleCount",
    "timeRangeMs",
    "recordedVariables",
    "spikeEventsCount",
    "executionTimeMs",
    "numericalStatus",
    "schemaVersion"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "minLength": 4
    },
    "modelId": {
      "type": "string",
      "pattern": "^MODEL-[0-9]{3}$"
    },
    "sampleCount": {
      "type": "integer",
      "minimum": 1
    },
    "timeRangeMs": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "recordedVariables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "unit",
          "minObserved",
          "maxObserved"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "minObserved": {
            "type": "number"
          },
          "maxObserved": {
            "type": "number"
          }
        }
      }
    },
    "spikeEventsCount": {
      "type": "integer",
      "minimum": 0
    },
    "executionTimeMs": {
      "type": "number",
      "minimum": 0
    },
    "numericalStatus": {
      "type": "string",
      "enum": [
        "CONVERGED",
        "DIVERGED_HALTED",
        "CANCELLED"
      ]
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    }
  }
}
