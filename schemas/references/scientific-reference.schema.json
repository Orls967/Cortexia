{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortexia.science/schemas/references/scientific-reference.schema.json",
  "title": "ScientificReference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "authors",
    "year",
    "venue",
    "identifier",
    "sourceType",
    "scientificTopics",
    "claimsSupported",
    "accessDate",
    "schemaVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REF-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "authors": {
      "type": "string",
      "minLength": 3
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2027
    },
    "venue": {
      "type": "string",
      "minLength": 2
    },
    "identifier": {
      "type": "string",
      "minLength": 5
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "PEER_REVIEWED_ARTICLE",
        "AUTHORITATIVE_TEXTBOOK",
        "OFFICIAL_DATASET_PORTAL",
        "ANATOMICAL_NOMENCLATURE_STANDARD"
      ]
    },
    "scientificTopics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "claimsSupported": {
      "type": "string",
      "minLength": 20
    },
    "accessDate": {
      "type": "string",
      "pattern": "^2026-11-16$"
    },
    "licensingNote": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    }
  }
}
