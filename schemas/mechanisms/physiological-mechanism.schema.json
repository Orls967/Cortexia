{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortexia.science/schemas/mechanisms/physiological-mechanism.schema.json",
  "title": "PhysiologicalMechanism",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "canonicalName",
    "mechanismDomain",
    "primaryScale",
    "timescaleRange",
    "shortDefinition",
    "detailedMechanism",
    "governingEquationIds",
    "associatedModelIds",
    "references",
    "schemaVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MECH-[A-Z0-9-]+$"
    },
    "canonicalName": {
      "type": "string",
      "minLength": 3
    },
    "mechanismDomain": {
      "type": "string",
      "enum": [
        "MEMBRANE_BIOPHYSICS",
        "ACTION_POTENTIAL_CONDUCTION",
        "SYNAPTIC_TRANSMISSION",
        "SHORT_TERM_PLASTICITY",
        "LONG_TERM_PLASTICITY",
        "HOMEOSTATIC_STRUCTURAL_PLASTICITY",
        "OSCILLATIONS_AND_SYNCHRONY",
        "GLIAL_METABOLIC_VASCULAR",
        "NEUROMODULATION_SIGNALING"
      ]
    },
    "primaryScale": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6",
        "L7",
        "L8",
        "L9"
      ]
    },
    "timescaleRange": {
      "type": "string",
      "minLength": 2
    },
    "shortDefinition": {
      "type": "string",
      "minLength": 40
    },
    "detailedMechanism": {
      "type": "string",
      "minLength": 60
    },
    "governingEquationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EQ-[A-Z0-9-]+$"
      }
    },
    "associatedModelIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^MODEL-[0-9]{3}$"
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^REF-[A-Z0-9-]+$"
      }
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    }
  }
}
