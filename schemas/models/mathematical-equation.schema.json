{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortexia.science/schemas/models/mathematical-equation.schema.json",
  "title": "MathematicalEquation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "domain",
    "latex",
    "lhsUnit",
    "rhsUnit",
    "variables",
    "description",
    "relatedModelIds",
    "references",
    "schemaVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EQ-[A-Z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "domain": {
      "type": "string",
      "minLength": 3
    },
    "latex": {
      "type": "string",
      "minLength": 5
    },
    "lhsUnit": {
      "type": "string",
      "minLength": 1
    },
    "rhsUnit": {
      "type": "string",
      "minLength": 1
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "meaning",
          "unit"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 2
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 30
    },
    "relatedModelIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^MODEL-[0-9]{3}$"
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^REF-[A-Z0-9-]+$"
      }
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    }
  }
}
