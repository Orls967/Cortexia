{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortexia.science/schemas/models/scientific-model.schema.json",
  "title": "ScientificModelDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "modelFamilyId",
    "modelFamilyName",
    "primaryScale",
    "abstractionLevel",
    "biologicalInterpretation",
    "governingEquationIds",
    "stateVariables",
    "parameterIds",
    "initialConditions",
    "numericalMethod",
    "computeEnvelope",
    "assumptions",
    "limitations",
    "validityDomain",
    "validationCaseIds",
    "references",
    "version",
    "schemaVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MODEL-[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "modelFamilyId": {
      "type": "string",
      "pattern": "^FAM-[0-9]{2}$"
    },
    "modelFamilyName": {
      "type": "string",
      "minLength": 3
    },
    "primaryScale": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6",
        "L7",
        "L8",
        "L9"
      ]
    },
    "abstractionLevel": {
      "type": "string",
      "minLength": 3
    },
    "biologicalInterpretation": {
      "type": "string",
      "minLength": 40
    },
    "governingEquationIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^EQ-[A-Z0-9-]+$"
      }
    },
    "stateVariables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "name",
          "unit"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "parameterIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^PARAM-[A-Z0-9-]+$"
      }
    },
    "initialConditions": {
      "type": "object",
      "minProperties": 1
    },
    "numericalMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultSolver",
        "supportedSolvers",
        "defaultDtMs",
        "minDtMs",
        "maxSafeDtMs"
      ],
      "properties": {
        "defaultSolver": {
          "type": "string",
          "pattern": "^SOLVER-"
        },
        "supportedSolvers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^SOLVER-"
          }
        },
        "defaultDtMs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minDtMs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxSafeDtMs": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "computeEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxUnitsInBrowser",
        "maxDurationMs",
        "workerMemoryBudgetMb"
      ],
      "properties": {
        "maxUnitsInBrowser": {
          "type": "integer",
          "minimum": 1
        },
        "maxDurationMs": {
          "type": "number",
          "minimum": 10
        },
        "workerMemoryBudgetMb": {
          "type": "integer",
          "minimum": 4
        }
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "validityDomain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "validationCaseIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^VAL-[A-Z0-9-]+$"
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^REF-[A-Z0-9-]+$"
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    }
  }
}
